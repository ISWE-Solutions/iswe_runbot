# Copy to .env and fill in. Never commit .env.

# Dashboard host; previews are served at <project>-<branch>.<DOMAIN>
DOMAIN=preview.example.com
# Production HTTPS (docker-compose.prod.yml): wildcard cert via DNS-01
TLS_ENABLED=false
# HTTPS is terminated by a proxy in front of the stack (keep TLS_ENABLED=false): Previewer
# builds https:// links and OAuth redirect URIs and marks its cookies Secure.
PUBLIC_HTTPS=false
ACME_EMAIL=ops@example.com
DNS_PROVIDER=cloudflare
DNS_API_TOKEN=

# Absolute host path for repos/, builds/, filestore/, logs/
DATA_DIR=/srv/previewer

# Required, at least 32 characters (the app and worker refuse to start without it):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

POSTGRES_USER=previewer
POSTGRES_PASSWORD=
POSTGRES_DB=previewer
# Each build gets its own Postgres role (pv_b<id>) owning only its database. ODOO_DB_USER is the
# shared role older versions used: the worker moves its databases to per-build roles, then locks it.
ODOO_DB_USER=odoo

# Default GitHub account, created on first start (then managed on the GitHub accounts page)
GITHUB_USERNAME=
GITHUB_TOKEN=
# Fallback Odoo Enterprise repo (one branch per version); each Odoo version can set its own
ENTERPRISE_REPO_URL=https://github.com/ISWE-Solutions/enterprise_addons.git

# Sign in to Previewer with Microsoft / GitHub. Easier: set these while signed in on
# System > Sign-in (saved in the database, secrets encrypted, applied without a restart); the
# values below are only the fallback for fields left blank there.
# Microsoft (Entra ID app registration, single tenant; anyone in the tenant).
# Redirect URI: https://<DOMAIN>/auth/microsoft/callback. Tenant ID = the directory GUID.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Sign in to Previewer with GitHub (OAuth App under the org; active members of GITHUB_SIGNIN_ORG
# only). Callback URL: https://<DOMAIN>/auth/github/callback. Not the GITHUB_TOKEN above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SIGNIN_ORG=ISWE-Solutions

ADMIN_EMAIL=admin@example.com

# Defaults for the System settings (the dashboard can change them later)
MAX_CONCURRENT_BUILDS=3
# Capped automatically to what fits in Docker's memory (System page: memory overcommit)
MAX_RUNNING_PREVIEWS=25
IDLE_SLEEP_HOURS=3
PREVIEW_MEMORY_LIMIT=1536m
# Memory kept free for Postgres, Traefik, app and worker
RESERVED_MEMORY=2g

