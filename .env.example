# Proxmox Configuration
PROXMOX_HOST=https://proxmox.example.com:8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your_proxmox_password
PROXMOX_VERIFY_SSL=false

# Flask Configuration
SECRET_KEY=your_secret_key_here_change_in_production
DATABASE_URL=sqlite:///demo_platform.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/iswe_meal_demo_platform

# Demo Instance Configuration
DEFAULT_INSTANCE_DURATION=24  # hours
MAX_INSTANCES_PER_USER=3
CONTAINER_OSTEMPLATE=local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst
CONTAINER_STORAGE=local-lvm
CONTAINER_BRIDGE=vmbr0

# Odoo Configuration
ODOO_VERSION=19.0
ODOO_REPO=https://github.com/odoo/odoo.git
ISWE_MEAL_REPO=https://github.com/ISWE-Solutions/iswe_meal_addons.git

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@example.com

# Logging
LOG_LEVEL=INFO
