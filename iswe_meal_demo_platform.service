[Unit]
Description=ISWE Meal Demo Platform
After=network.target redis.service postgresql.service

[Service]
Type=notify
User=demo
Group=demo
WorkingDirectory=/opt/iswe_meal_demo_platform
Environment="PATH=/opt/iswe_meal_demo_platform/venv/bin"
ExecStart=/opt/iswe_meal_demo_platform/venv/bin/gunicorn --workers 4 --bind 0.0.0.0:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
