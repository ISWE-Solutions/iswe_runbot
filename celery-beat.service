[Unit]
Description=Celery Beat for ISWE Meal Demo Platform
After=network.target redis.service

[Service]
Type=simple
User=demo
Group=demo
WorkingDirectory=/opt/iswe_meal_demo_platform
Environment="PATH=/opt/iswe_meal_demo_platform/venv/bin"
ExecStart=/opt/iswe_meal_demo_platform/venv/bin/celery -A tasks beat --loglevel=info
Restart=always

[Install]
WantedBy=multi-user.target
